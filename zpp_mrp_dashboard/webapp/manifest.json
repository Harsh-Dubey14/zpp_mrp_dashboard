{
  "_version": "1.86.0",
  "sap.app": {
    "id": "zpp.mrp.dashboard.zppmrpdashboard",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.30.0",
      "toolsId": "18d2e975-2d94-4c7c-af45-14eab50991c7"
    },
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_mrp_lable_api_o4/srvd_a2x/sap/zui_mrp_lable_api/0001/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "config": {
      "fullWidth": true
    },
    "fullwidth": true,
    "contentwidth": "fullwidth",
    "dependencies": {
      "minUI5Version": "1.148.10",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.viz": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "zpp.mrp.dashboard.zppmrpdashboard.i18n.i18n",
          "supportedLocales": [""],
          "fallbackLocale": ""
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "zpp.mrp.dashboard.zppmrpdashboard.view",
        "controlId": "app",
        "controlAggregation": "pages",
        "async": true
      },

      "routes": [
        {
          "name": "RouteDashboard",
          "pattern": ":?query:",
          "target": ["TargetDashboard"]
        }
      ],

      "targets": {
        "TargetDashboard": {
          "id": "Dashboard",
          "name": "Dashboard"
        }
      }
    },
    "rootView": {
      "viewName": "zpp.mrp.dashboard.zppmrpdashboard.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
